# Copy this file to .env in this same directory (apps/server/.env) and
# uncomment/edit whatever you need. Everything below has a working default —
# .env is entirely optional.

# API server port. Change this if 5174 is already in use on your machine.
# PORT=5174

# API server bind address.
# HOST=127.0.0.1

# Log verbosity: "info" prints request/response logs, "warn" (default) is quiet.
# LOG_LEVEL=info

# Shortcut for LOG_LEVEL=info.
# DEBUG=1

# Base URL of the web app, used to build the sign-in link printed on startup.
# Only needed if you changed the web app's port too (see apps/web/vite.config.ts).
# WEB_URL=http://localhost:5173
